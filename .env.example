# Optional deployment defaults. VITE_* values are public in the browser bundle.
VITE_APP_NAME="Cotizador de traslados"

# Two-letter country code; leave empty to search worldwide.
VITE_GEOCODING_COUNTRY=CL
VITE_MAP_LATITUDE=-33.4489
VITE_MAP_LONGITUDE=-70.6693

# Replace demo endpoints with services suitable for your public deployment.
# Empty geocoding/routing URLs disable that service; manual entry still works.
VITE_PHOTON_URL=https://photon.komoot.io/api/
# Optional Nominatim-compatible service or your own proxy with caching/global limits.
VITE_REVERSE_GEOCODING_URL=
VITE_OSRM_URL=https://router.project-osrm.org/route/v1/driving
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
